{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GCSE Revise Smart Lesson Schema",
  "type": "object",
  "required": ["subject", "board", "topic", "steps"],
  "properties": {
    "subject": { "type": "string" },
    "board": { "type": "string", "enum": ["AQA", "Edexcel", "OCR", "Eduqas", "CCEA"] },
    "tier": { "type": "string", "enum": ["Foundation", "Higher", ""] },
    "topic": { "type": "string" },
    "topicName": { "type": "string" },
    "version": { "type": "integer", "default": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "title", "body"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "kind": { "type": "string", "enum": ["learn", "example", "try", "check", "review"] },
          "title": { "type": "string", "minLength": 1 },
          "body": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
